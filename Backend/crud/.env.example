DATABASE_URL = "postgresql+psycopg2://username:password@localhost:5432/database_name"  # Replace with your actual database URL
PAPER_UPLOAD_DIR = "/path/to/upload/directory"  # Replace with the actual path where you want to store uploaded papers
PAPER_MAX_MB = "10"  # Maximum size of the uploaded paper in megabytes

# Turnstile hostname allow-list. These are the LOCAL dev hostnames; the production
# deployment must set only the real frontend hostname:
#   TURNSTILE_HOSTNAMES = example.com
TURNSTILE_HOSTNAMES = localhost,127.0.0.1
TURNSTILE_SECRET = ""