# Keep the image free of anything that is state, secret, or local to a machine.

# Secrets and per-machine config. The container is configured through environment
# variables (see deploy/README.md); nothing from .env belongs in an image layer.
.env
**/.env
*.env

# Local state: the app writes these under /data in the container, not here.
logs/
crud/pdf_uploads/
**/__pycache__/
**/*.py[cod]

# Local virtualenv and tooling leftovers.
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Scratch file from learning FastAPI; not imported by the app.
example.py
