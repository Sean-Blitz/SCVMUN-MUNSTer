# Copy to .env (gitignored) and fill in. Docker Compose reads this file for the
# ${...} substitutions in compose.yaml - it is not copied into any image.
#
# `cp .env.example .env && chmod 600 .env`

# --- database ---------------------------------------------------------------
# Required: compose refuses to start without it.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=scvmun
POSTGRES_DB=scvmun

# --- human check (Cloudflare Turnstile) -------------------------------------
# The two values work as a pair: an empty secret turns the check off, while a secret
# with an empty hostname list rejects every login on purpose. Production must list only
# the real frontend hostname - never localhost.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFfdf-btRVoOqr55
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=scvmun.esuhsd.org

# --- optional ---------------------------------------------------------------
# The SPA and the API share an origin through nginx, so CORS is not exercised here.
# CORS_ALLOW_ORIGINS=https://scvmun.esuhsd.org

# Image tag used by both builds; a git sha or a version works well.
SCVMUN_TAG=local

# Host ports. Change 80/443 if something else already owns them.
WEB_PORT=80
WEB_TLS_PORT=443

# Directory holding fullchain.pem and privkey.pem. Defaults to ./tls next to this file.
# It is mounted read-only into the web container and is gitignored - see deploy/TLS.md.
# TLS_DIR=./tls
