VITE_API_BASE_URL=https://api.yourdomain.com/api

# Cloudflare Turnstile site key (public, safe to ship to the browser).
# Leave empty to disable the human check in development; the backend disables it too when
# TURNSTILE_SECRET_KEY is unset. Cloudflare's "always passes" test key is:
#   1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
